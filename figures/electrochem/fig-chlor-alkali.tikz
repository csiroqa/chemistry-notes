% 图：氯碱工业（离子交换膜法电解饱和食盐水）
\begin{tikzpicture}[x=1cm, y=1cm, every node/.style={font=\small\ssans}]
    % 电解槽
    \draw[rounded corners=6pt] (-3.6,0) -- (-3.6,-3.4) -- (3.6,-3.4) -- (3.6,0);
    \draw[rounded corners=6pt, fill=blue!10] (-3.6,-3.4) -- (-3.6,-1.0) -- (3.6,-1.0) -- (3.6,-3.4) -- cycle;
    % 阳离子交换膜
    \draw[thick, dashed, draw=red!70!black] (0,-1.0) -- (0,-3.4);
    \node[font=\scriptsize, red!70!black] at (0,-0.5) {阳离子交换膜（\cemh{Na+} 通过）};
    % 电极：阳极（石墨/钛，左 +）与阴极（铁网，右 -）
    \draw[fill=black!60, draw=black!85] (-3.3,-1.1) rectangle (-3.05,-2.9);
    \draw[fill=gray!55, draw=black!75] (3.05,-1.1) rectangle (3.3,-2.9);
    % 直流电源
    \draw (-3.2,-1.1) -- (-3.2,1.9);
    \draw (3.2,-1.1) -- (3.2,1.9);
    \draw[ultra thick] (-3.85,1.9) -- (-2.55,1.9);
    \draw[very thick] (-3.55,2.3) -- (-2.85,2.3);
    \node[left=2pt] at (-3.7,2.3) {\textcolor{red}{$+$}};
    \node[right=2pt] at (-2.75,2.3) {\textcolor{blue}{$-$}};
    \draw[->,blue!60!black,very thick] (-2.4,1.5) -- (2.4,1.5) node[midway, above, font=\small] {\cemh{e-}};
    % 气泡
    \fill[gray!60] (-2.85,-1.15) circle (0.045);
    \fill[gray!60] (-3.0,-1.5) circle (0.045);
    \fill[gray!60] (-2.7,-1.8) circle (0.045);
    \fill[gray!60] (-3.1,-2.2) circle (0.045);
    \fill[gray!60] (3.1,-1.15) circle (0.045);
    \fill[gray!60] (3.25,-1.6) circle (0.045);
    \fill[gray!60] (2.9,-1.9) circle (0.045);
    \fill[gray!60] (3.2,-2.4) circle (0.045);
    \node[font=\small] at (-2.4,-1.2) {\cemh{Cl2}↑};
    \node[font=\small] at (2.4,-1.2) {\cemh{H2}↑};
    % 进出料
    \node[font=\small] at (-1.8,-3.75) {饱和 \cemh{NaCl} 溶液（阳极室）};
    \node[font=\small] at (1.8,-3.75) {稀 \cemh{NaOH} 溶液（阴极室）};
    \node[font=\small] at (-3.2,0.35) {阳极（石墨）\textcolor{red}{$+$}};
    \node[font=\small] at (3.2,0.35) {阴极（铁网）\textcolor{blue}{$-$}};
    \node[font=\footnotesize, red] at (0,-4.15) {阳极：\cemh{2Cl- - 2e- = Cl2 ^}\quad 阴极：\cemh{2H2O + 2e- = H2 ^ + 2OH-}};
\end{tikzpicture}
