% 冰：水分子（O 红、H 黑点）以氢键（蓝虚线）连成四面体网络（示意）
\begin{tikzpicture}[
    x={(2.26cm,1.30cm)}, y={(-2.26cm,1.30cm)}, z={(0cm,2.60cm)},
    line width=0.9pt,
]
    % 氢键（蓝色虚线）：中心 O → 近邻 O
    \draw[blue!55!black, dashed, line width=1.0pt] (0,0,0) -- (0,0,1.0);
    \draw[blue!55!black, dashed, line width=1.0pt] (0,0,0) -- (0.943,0,-0.333);
    \draw[blue!55!black, dashed, line width=1.0pt] (0,0,0) -- (-0.471,0.816,-0.333);
    \draw[blue!55!black, dashed, line width=1.0pt] (0,0,0) -- (-0.471,-0.816,-0.333);
    % 近邻水分子 O（后浅前深）
    \cellatom{red!60!white}{0}{0}{1.0}{0.50}
    \cellatom{red!60!white}{-0.471}{0.816}{-0.333}{0.50}
    \cellatom{red!60!white}{-0.471}{-0.816}{-0.333}{0.50}
    \cellatom{red!70!black}{0.943}{0}{-0.333}{0.50}
    \cellatom{red!70!black}{0}{0}{0}{0.50}
    % H 原子（黑点，位于键上 1/3 处，示意 O—H···O）
    \cellatom{black!75}{0}{0}{0.36}{0.15}
    \cellatom{black!75}{0.314}{0}{-0.111}{0.15}
    \cellatom{black!75}{-0.157}{0.272}{-0.111}{0.15}
    \cellatom{black!75}{-0.157}{-0.272}{-0.111}{0.15}
\end{tikzpicture}
